# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Reported by GET /api/health and the OpenAPI document
APP_VERSION=0.0.0-dev

# MongoDB Atlas connection string, with the database name in the path.
# Development uses its own database on the same cluster: …mongodb.net/ancestors-tree-dev?retryWrites=true&w=majority
# Optional until P3 (accounts and clans). Never commit the real value.
MONGODB_URI=
# Cloudinary "API environment variable" from the dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional until P6 (photo upload). Never commit the real value.
CLOUDINARY_URL=
# Root folder for uploads: ancestors-tree/dev locally, ancestors-tree/prod on Render (spec §12, image storage)
CLOUDINARY_FOLDER=ancestors-tree/dev

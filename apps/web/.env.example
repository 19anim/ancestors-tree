# The public Cloudinary cloud name (the part after @ in the API's CLOUDINARY_URL).
# Not a secret: it is part of every photo URL. Leave empty to run without photos.
VITE_CLOUDINARY_CLOUD_NAME=

# Production builds only: the React project's Sentry DSN (Sentry → Project settings → Client
# Keys). Public by design, like every value the browser sees. Leave it empty locally.
VITE_SENTRY_DSN=
# Source map upload happens only on Netlify, from SENTRY_AUTH_TOKEN, SENTRY_ORG and
# SENTRY_PROJECT set there (docs/deployment.md §7). Never put the token in this file.
